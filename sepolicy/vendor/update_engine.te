allow update_engine custom_ab_block_device:blk_file rw_file_perms;
allow update_engine modem_block_device:blk_file rw_file_perms;
allow update_engine userdata_exp_block_device:blk_file { getattr ioctl open read };

allowxperm update_engine userdata_exp_block_device:blk_file ioctl { BLKGETSIZE64 BLKIOMIN BLKALIGNOFF };

dontaudit update_engine mnt_vendor_file:dir search;
