allow fastbootd devpts:chr_file rw_file_perms;

recovery_only(`
allow fastbootd citadel_device:chr_file rw_file_perms;
allow fastbootd custom_ab_block_device:blk_file rw_file_perms;
allow fastbootd device:dir { ioctl lock open read watch watch_reads };
allow fastbootd devinfo_block_device:blk_file rw_file_perms;
allow fastbootd metadata_file:dir { getattr mounton };
allow fastbootd proc_vendor_sched:dir { ioctl lock open read search watch watch_reads };
allow fastbootd rootfs:dir { ioctl lock mounton open read watch watch_reads };
allow fastbootd sda_block_device:blk_file rw_file_perms;
allow fastbootd st54spi_device:chr_file rw_file_perms;
allow fastbootd sysfs_dm:dir { ioctl lock open read search watch watch_reads };
allow fastbootd sysfs_dt_firmware_android:dir { ioctl lock open read search watch watch_reads };
allow fastbootd sysfs_ota:file rw_file_perms;
allow fastbootd vendor_file:dir { ioctl lock open read watch watch_reads };
')
