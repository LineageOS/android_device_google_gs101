    <!-- Generic error message shown when fingerprint needs calibration [CHAR LIMIT=150] -->
    <string name="fingerprint_error_bad_calibration">Մատնահետքերի սկաները հնարավոր չէ օգտագործել։ Այցելեք սպասարկման կենտրոն կամ g.co/pixel/fingerprintunlock էջ։</string>

    <!-- Array containing custom error messages from vendor.  Vendor is expected to add and translate these strings -->
