        <item/>
        <item/>
        <item/>
        <item/>
        <item/>
        <item/>
        <item>Bad data. Try again.</item>
        <item>Failed to enrol finger. Try again.</item>
    </string-array>

    <!-- Notification content shown when the system requires the user to re-calibrate their fingerprint. [CHAR LIMIT=NONE] -->
    <string name="fingerprint_recalibrate_notification_content">Visit a repair provider or g.co/pixel/fingerprintunlock</string>
